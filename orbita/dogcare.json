        "brincou",
        "correu"
      ],
      "strong": [
        "passeou",
        "passeio",
        "passear",
        "caminhada com"
      ],
      "none": [
        "treinei",
        "corri",
        "eu corri",
        "treino"
      ],
      "slots": {
        "min": "qty:min",
        "intensity": "choice"
      }
    },
    {
      "id": "peso",
      "mode": "log",
      "event": "weight",
      "any": [
        "pesou",
        "peso",
        "pesa",
        "kg",
        "quilos",
        "balanca"
      ],
      "none": [
        "eu peso",
        "pesei",
        "me pesei",
        "ela pesou",
        "ela pesa"
      ],
      "needsSubject": true,
      "slots": {
        "kg": "qty:kg",
