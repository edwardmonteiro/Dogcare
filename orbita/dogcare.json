  "examples": [
    "o cachorro comeu 120 g de ração",
    "dei 2 petiscos pro Thor",
    "Thor passeou 40 minutos",
    "o cachorro pesou 14,2 kg",
    "o cachorro vomitou duas vezes",
    "dei o vermífugo do cachorro",
    "cachorro pode comer uva?"
  ],
  "screens": {
    "home": {
      "title": "{{settings.dogName}}",
      "blocks": [
        {
          "type": "hero",
          "text": "{{fmt(sum('meal', 'kcal', 'today'))}} de {{fmt(nz(settings.kcalTarget, 800))}} kcal",
          "caption": "{{sum('meal', 'kcal', 'today') < nz(settings.kcalTarget, 800) ? 'Faltam cerca de ' + fmt((nz(settings.kcalTarget, 800) - sum('meal', 'kcal', 'today')) * 100 / nz(settings.foodKcal100, 360)) + ' g de ração' : 'Meta do dia atingida'}}{{settings.dogBirth ? ' · ' + ageText(settings.dogBirth) : ''}}"
        },
        {
          "type": "metrics",
          "items": [
            {
              "label": "Energia",
              "value": "{{fmt(sum('meal', 'kcal', 'today'))}}",
              "unit": "kcal",
              "progress": "{{sum('meal', 'kcal', 'today') / nz(settings.kcalTarget, 800)}}"
            },
            {
              "label": "Passeio",
              "value": "{{fmt(sum('walk', 'min', 'today'))}}",
              "unit": "min",
              "progress": "{{sum('walk', 'min', 'today') / nz(settings.walkTarget, 45)}}"
            },
            {
              "label": "Água",
              "value": "{{fmt(sum('water', 'ml', 'today'))}}",
              "unit": "ml"
            },
            {
              "label": "Peso",
              "value": "{{count('weight', 'all') ? fmt(last('weight').kg, 1) : '–'}}",
              "unit": "kg",
              "sub": "{{count('weight', 'all') ? ago(last('weight').at) : 'sem registro'}}"
            }
          ]
        },
        {
          "type": "note",
          "tone": "warn",
          "if": "count('meal', '7d') >= 4 && avg(daily('meal', 'kcal', 7, 'sum')) > nz(settings.kcalTarget, 800) * 1.1",
          "text": "Média da semana acima da meta: {{fmt(avg(daily('meal', 'kcal', 7, 'sum')))}} kcal por dia."
        },
        {
          "type": "note",
          "tone": "warn",
          "if": "count('symptom', '7d') >= 2",
          "text": "{{count('symptom', '7d')}} sintomas na semana. Se persistirem, fale com o veterinário."
        },
        {
          "type": "logger",
          "event": "meal",
          "title": "Registrar refeição"
        },
        {
          "type": "actions",
          "items": [
            {
              "label": "Passeio",
              "action": "screen",
              "args": {
                "to": "rotina"
              }
            },
            {
              "label": "Saúde",
              "action": "screen",
              "args": {
                "to": "saude"
              }
            },
            {
              "label": "Evolução",
              "action": "screen",
              "args": {
                "to": "evolucao"
              }
            },
            {
              "label": "Pode comer?",
              "action": "screen",
              "args": {
                "to": "pode"
              }
            }
          ]
        },
        {
          "type": "timeline",
          "title": "Hoje",
          "events": [
            "meal",
            "water",
            "walk",
            "potty",
            "weight",
            "symptom",
            "care",
            "med"
          ],
          "range": "today",
          "limit": 20
        }
      ]
    },
    "rotina": {
      "title": "Rotina",
      "blocks": [
        {
          "type": "logger",
          "event": "walk",
          "title": "Passeio"
        },
        {
          "type": "logger",
          "event": "water",
          "title": "Água"
        },
        {
          "type": "logger",
          "event": "potty",
          "title": "Xixi e cocô"
        },
        {
          "type": "chart",
          "kind": "bars",
          "label": "Passeio por dia",
          "values": "{{daily('walk', 'min', 7, 'sum')}}",
          "labels": "{{days(7)}}",
          "unit": "min",
          "target": "{{nz(settings.walkTarget, 45)}}"
        },
        {
          "type": "timeline",
          "title": "Últimos 7 dias",
          "events": [
            "walk",
            "water",
            "potty"
          ],
          "range": "7d",
          "limit": 30
        }
      ]
    },
    "saude": {
      "title": "Saúde",
      "blocks": [
        {
          "type": "note",
          "tone": "bad",
          "text": "Emergência: dificuldade para respirar, barriga inchada ou dura, tentar vomitar sem sair nada, convulsão, desmaio, gengiva pálida, não conseguir urinar ou suspeita de intoxicação. Vá ao veterinário ou à clínica 24 h agora."
        },
        {
          "type": "section",
          "text": "Vacinas e antiparasitários"
        },
        {
          "type": "logger",
          "event": "care",
          "title": "Registrar cuidado"
        },
        {
          "type": "timeline",
          "title": "Histórico",
          "events": [
            "care"
          ],
          "range": "all",
          "limit": 20
        },
        {
          "type": "section",
          "text": "Remédios"
        },
        {
          "type": "note",
          "tone": "info",
          "if": "settings.medOn == 'sim'",
          "text": "{{settings.medName}} às {{settings.medTime}}. Use a dose da receita."
        },
        {
          "type": "logger",
          "event": "med",
          "title": "Dei o remédio"
        },
        {
          "type": "section",
          "text": "Sintomas"
        },
        {
          "type": "logger",
          "event": "symptom",
          "title": "Registrar sintoma"
        },
        {
          "type": "timeline",
          "title": "Últimos 30 dias",
          "events": [
            "symptom",
            "med"
          ],
          "range": "30d",
          "limit": 30
        }
      ]
    },
    "evolucao": {
      "title": "Evolução",
      "blocks": [
        {
          "type": "chart",
          "kind": "line",
          "label": "Peso",
          "values": "{{series('weight', 'kg', 'all')}}",
          "labels": "{{seriesDates('weight', 'all')}}",
          "unit": "kg",
          "target": "{{settings.idealKg}}"
        },
        {
          "type": "note",
          "tone": "info",
          "text": "Escore corporal ideal: 4 a 5 de 9. Costelas fáceis de sentir sem apertar e cintura visível de cima."
        },
        {
          "type": "logger",
          "event": "weight",
          "title": "Pesar"
        },
        {
          "type": "section",
          "text": "Bem-estar do mês (0 a 5)"
        },
        {
          "type": "radar",
          "event": "wellness",
          "areas": [
            "energia",
            "apetite",
            "pelagem",
            "mobilidade",
            "digestão",
            "sono",
            "humor"
          ],
          "max": 5
        },
        {
          "type": "logger",
          "event": "wellness",
          "title": "Avaliar uma área"
        },
        {
          "type": "chart",
          "kind": "bars",
          "label": "Energia ingerida por dia",
          "values": "{{daily('meal', 'kcal', 7, 'sum')}}",
          "labels": "{{days(7)}}",
          "unit": "kcal",
          "target": "{{nz(settings.kcalTarget, 800)}}"
        }
      ]
    },
    "pode": {
      "title": "Pode ou não pode?",
      "blocks": [
        {
          "type": "note",
          "tone": "bad",
          "text": "Não pode: chocolate, uva e uva-passa, xilitol (doces diet, chicletes), cebola, alho, cebolinha, macadâmia, álcool, café, massa crua com fermento e remédios de gente (paracetamol, ibuprofeno)."
        },
        {
          "type": "note",
          "tone": "warn",
          "text": "Evite: ossos cozidos, abacate, leite e laticínios, embutidos e frituras, alimentos crus, caroços e sementes."
        },
        {
          "type": "note",
          "tone": "good",
          "text": "Pode, em pouca quantidade, cozido e sem tempero: cenoura, abóbora, maçã e pera sem sementes, banana, melancia sem caroço, mamão, frango, carne magra, peixe sem espinha, arroz, ovo cozido, batata-doce, vagem."
        },
        {
          "type": "note",
          "tone": "info",
          "text": "Petiscos devem somar no máximo 10% das calorias do dia. Se ele comeu algo da lista vermelha, ligue para o veterinário agora, mesmo sem sintomas."
        }
      ]
    }
  },
  "card": [
    {
      "type": "metrics",
      "items": [
        {
          "label": "Energia",
          "value": "{{fmt(sum('meal', 'kcal', 'today'))}}",
          "unit": "kcal",
          "progress": "{{sum('meal', 'kcal', 'today') / nz(settings.kcalTarget, 800)}}"
        },
        {
          "label": "Passeio",
          "value": "{{fmt(sum('walk', 'min', 'today'))}}",
          "unit": "min"
        },
        {
          "label": "Peso",
          "value": "{{count('weight', 'all') ? fmt(last('weight').kg, 1) : '–'}}",
          "unit": "kg"
        }
      ]
    },
    {
      "type": "actions",
      "items": [
        {
          "label": "Ração",
          "action": "prompt",
          "args": {
            "text": "o cachorro comeu 100 g de ração"
          }
        },
        {
          "label": "Passeio",
          "action": "screen",
          "args": {
            "to": "rotina"
          }
        },
        {
          "label": "Saúde",
          "action": "screen",
          "args": {
            "to": "saude"
          }
        }
      ]
    }
  ],
  "reactions": [
    {
      "id": "sintoma-forte",
      "on": "dogcare.symptom",
      "if": "ev.level == 'forte' || count('symptom', 'today') >= 2",
      "do": "alert",
      "priority": "urgent",
      "text": "{{settings.dogName}}: sintoma forte ou repetido hoje ({{ev.sym}}). Ligue para o veterinário; em sinais de emergência, vá à clínica 24 h."
    },
    {
      "id": "diarreia",
      "on": "dogcare.potty",
      "if": "ev.stool == 'diarreia'",
      "do": "insight",
      "priority": "normal",
      "text": "Diarreia registrada. Ofereça água e observe. Se repetir, tiver sangue ou ele ficar abatido, procure o veterinário."
    },
    {
      "id": "petiscos",
      "on": "dogcare.meal",
      "if": "ev.food == 'petisco'",
      "do": "insight",
      "priority": "normal",
      "text": "Lembrete: petiscos devem ficar abaixo de 10% das calorias do dia ({{fmt(nz(settings.kcalTarget, 800) * 0.1)}} kcal)."
    },
    {
      "id": "chuva-passeio",
      "on": "dia.weather",
      "if": "feeds.weather.ok && feeds.weather.prob >= 70",
      "do": "insight",
      "priority": "normal",
      "text": "Chance alta de chuva hoje. Antecipe o passeio de {{settings.dogName}} ou troque por 10 minutos de farejar petiscos em casa."
    }
  ],
  "reminders": [
    {
      "id": "remedio",
      "if": "settings.medOn == 'sim'",
      "time": "{{settings.medTime}}",
      "text": "{{settings.medName}} de {{settings.dogName}}",
      "prompt": "dei o remédio do cachorro"
    }
  ],
  "digest": "{{count('meal', 'today') || count('walk', 'today') ? settings.dogName + ': ' + fmt(sum('meal', 'kcal', 'today')) + ' de ' + fmt(nz(settings.kcalTarget, 800)) + ' kcal, ' + fmt(sum('walk', 'min', 'today')) + ' min de passeio' + (count('symptom', 'today') ? ', ' + count('symptom', 'today') + ' sintoma(s)' : '') + '.' : ''}}"
}