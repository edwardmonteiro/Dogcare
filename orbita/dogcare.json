{
  "schema": "orbita.miniapp/v1",
  "id": "dogcare",
  "name": "DogCare",
  "version": 1,
  "order": 40,
  "glyph": "🐾",
  "accent": {
    "light": "#C8643B",
    "dark": "#E08158"
  },
  "description": "Cuidados do cachorro da família: ração e petiscos (kcal), água, passeios, peso e escore corporal, xixi e cocô, sintomas, vacinas, vermífugo, antipulgas, remédios e bem-estar mensal. Os dados são do cão, não do usuário nem da bebê.",
  "subject": {
    "id": "familia",
    "label": "{{settings.dogName}}",
    "words": [
      "cachorro",
      "cachorra",
      "cao",
      "cadela",
      "dog",
      "pet",
      "{{settings.dogName}}"
    ]
  },
  "notify": {
    "suggest": "Só no resumo"
  },
  "settings": [
    {
      "key": "dogName",
      "label": "Nome do cão",
      "kind": "text",
      "default": "Thor"
    },
    {
      "key": "dogBirth",
      "label": "Nascimento",
      "kind": "date"
    },
    {
      "key": "kcalTarget",
      "label": "Meta diária (kcal) definida com o veterinário",
      "kind": "number",
      "unit": "kcal",
      "min": 100,
      "max": 5000,
      "default": "800"
    },
    {
      "key": "foodKcal100",
      "label": "Ração principal: kcal por 100 g (embalagem ÷ 10)",
      "kind": "number",
      "unit": "kcal",
      "min": 200,
      "max": 600,
      "default": "360"
    },
    {
      "key": "treatKcal100",
      "label": "Petisco: kcal por 100 g",
      "kind": "number",
      "unit": "kcal",
      "min": 100,
      "max": 600,
      "default": "320"
    },
    {
      "key": "idealKg",
      "label": "Peso ideal (kg), se o veterinário indicou",
      "kind": "number",
      "unit": "kg",
      "min": 0.5,
      "max": 100
    },
    {
      "key": "walkTarget",
      "label": "Passeio por dia (min)",
      "kind": "number",
      "unit": "min",
      "min": 10,
      "max": 240,
      "default": "45"
    },
    {
      "key": "medOn",
      "label": "Lembrar remédio diário",
      "kind": "choice",
      "options": [
        "não",
        "sim"
      ],
      "default": "não"
    },
    {
      "key": "medName",
      "label": "Remédio (como está na receita)",
      "kind": "text"
    },
    {
      "key": "medTime",
      "label": "Horário do remédio",
      "kind": "text",
      "default": "08:00"
    }
  ],
  "events": {
    "meal": {
      "label": "Refeição do cão",
      "fields": [
        {
          "key": "food",
          "label": "Alimento",
          "kind": "choice",
          "options": [
            "ração",
            "úmida",
            "petisco",
            "natural"
          ],
          "match": {
            "ração": [
              "racao",
              "comida",
              "tigela",
              "pote"
            ],
            "úmida": [
              "sache",
              "umida",
              "pate",
              "lata"
            ],
            "petisco": [
              "petisco",
              "biscoito",
              "bifinho",
              "ossinho",
              "snack"
            ],
            "natural": [
              "frango",
              "cenoura",
              "carne",
              "abobora",
              "fruta"
            ]
          },
          "default": "ração"
        },
        {
          "key": "g",
          "label": "Quantidade",
          "kind": "number",
          "unit": "g",
          "min": 1,
          "max": 2000
        },
        {
          "key": "kcal",
          "label": "Energia",
          "kind": "number",
          "unit": "kcal",
          "hidden": true
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "derive": {
        "kcal": "round(food == 'petisco' ? g * nz(settings.treatKcal100, 320) / 100 : food == 'úmida' ? g * 0.9 : food == 'natural' ? g * 1.5 : g * nz(settings.foodKcal100, 360) / 100)"
      },
      "validate": [
        {
          "expr": "g > 0",
          "msg": "Informe a quantidade em gramas."
        }
      ],
      "summary": "{{food}} · {{fmt(g)}} g · {{fmt(kcal)}} kcal"
    },
    "water": {
      "label": "Água do cão",
      "fields": [
        {
          "key": "ml",
          "label": "Água",
          "kind": "number",
          "unit": "ml",
          "min": 10,
          "max": 5000
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "Água · {{fmt(ml)}} ml"
    },
    "walk": {
      "label": "Passeio",
      "fields": [
        {
          "key": "min",
          "label": "Duração",
          "kind": "number",
          "unit": "min",
          "min": 1,
          "max": 480
        },
        {
          "key": "intensity",
          "label": "Intensidade",
          "kind": "choice",
          "options": [
            "leve",
            "moderada",
            "intensa"
          ],
          "match": {
            "intensa": [
              "correu",
              "corrida",
              "trilha"
            ],
            "moderada": [
              "brincou",
              "bola",
              "parque"
            ]
          },
          "default": "leve"
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "Passeio · {{fmt(min)}} min · {{intensity}}"
    },
    "weight": {
      "label": "Peso do cão",
      "fields": [
        {
          "key": "kg",
          "label": "Peso",
          "kind": "number",
          "unit": "kg",
          "min": 0.5,
          "max": 100
        },
        {
          "key": "bcs",
          "label": "Escore corporal (1–9)",
          "kind": "scale",
          "min": 1,
          "max": 9
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "Peso · {{fmt(kg, 1)}} kg{{bcs ? ' · escore ' + bcs + '/9' : ''}}"
    },
    "potty": {
      "label": "Xixi e cocô",
      "fields": [
        {
          "key": "what",
          "label": "O que fez",
          "kind": "choice",
          "options": [
            "xixi",
            "cocô",
            "os dois"
          ],
          "match": {
            "xixi": [
              "xixi",
              "urinou"
            ],
            "cocô": [
              "coco",
              "fezes",
              "evacuou"
            ],
            "os dois": [
              "necessidades",
              "os dois"
            ]
          },
          "default": "xixi"
        },
        {
          "key": "stool",
          "label": "Fezes",
          "kind": "choice",
          "options": [
            "normal",
            "mole",
            "dura",
            "diarreia"
          ],
          "match": {
            "mole": [
              "mole",
              "pastosa"
            ],
            "dura": [
              "dura",
              "ressecada"
            ],
            "diarreia": [
              "diarreia",
              "liquida"
            ]
          },
          "default": "normal"
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "{{what}}{{what != 'xixi' ? ' · fezes ' + stool : ''}}"
    },
    "symptom": {
      "label": "Sintoma do cão",
      "fields": [
        {
          "key": "sym",
          "label": "Sintoma",
          "kind": "choice",
          "options": [
            "vômito",
            "diarreia",
            "sem apetite",
            "apatia",
            "tosse",
            "coceira",
            "mancando",
            "olhos",
            "ouvido",
            "outro"
          ],
          "match": {
            "vômito": [
              "vomit*"
            ],
            "diarreia": [
              "diarreia",
              "coco mole"
            ],
            "sem apetite": [
              "nao comeu",
              "sem apetite",
              "recusou"
            ],
            "apatia": [
              "apatico",
              "abatido",
              "prostrado",
              "desanimado"
            ],
            "tosse": [
              "tosse",
              "tossi*"
            ],
            "coceira": [
              "coceira",
              "cocando"
            ],
            "mancando": [
              "mancando",
              "mancou"
            ],
            "olhos": [
              "olho*"
            ],
            "ouvido": [
              "ouvido",
              "orelha"
            ]
          },
          "default": "outro"
        },
        {
          "key": "level",
          "label": "Intensidade",
          "kind": "choice",
          "options": [
            "leve",
            "moderado",
            "forte"
          ],
          "match": {
            "forte": [
              "muito",
              "varias vezes",
              "forte",
              "sangue"
            ],
            "leve": [
              "pouco",
              "leve",
              "uma vez"
            ]
          },
          "default": "moderado"
        },
        {
          "key": "note",
          "label": "Detalhes",
          "kind": "text",
          "concept": "texto.nota"
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "{{sym}} · {{level}}{{note ? ' · ' + note : ''}}"
    },
    "care": {
      "label": "Vacina, vermífugo ou antipulgas",
      "fields": [
        {
          "key": "type",
          "label": "Cuidado",
          "kind": "choice",
          "options": [
            "vacina",
            "vermífugo",
            "antipulgas",
            "consulta"
          ],
          "match": {
            "vacina": [
              "vacina",
              "v8",
              "v10",
              "antirrabica",
              "raiva",
              "gripe",
              "giardia",
              "leishmaniose"
            ],
            "vermífugo": [
              "vermifugo",
              "verme"
            ],
            "antipulgas": [
              "antipulga*",
              "pulga",
              "carrapato",
              "bravecto",
              "simparic",
              "nexgard"
            ],
            "consulta": [
              "veterinario",
              "consulta",
              "exame",
              "vet"
            ]
          },
          "default": "vacina"
        },
        {
          "key": "name",
          "label": "Nome / produto",
          "kind": "text",
          "concept": "texto.nota"
        },
        {
          "key": "next",
          "label": "Próxima dose",
          "kind": "date"
        },
        {
          "key": "at",
          "label": "Data",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "{{type}}{{name ? ' · ' + name : ''}}{{next ? ' · próxima ' + date(next) : ''}}"
    },
    "med": {
      "label": "Remédio dado ao cão",
      "fields": [
        {
          "key": "name",
          "label": "Remédio",
          "kind": "text",
          "default": "{{settings.medName}}",
          "concept": "texto.nota"
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "Remédio · {{name}}"
    },
    "wellness": {
      "label": "Bem-estar mensal",
      "fields": [
        {
          "key": "area",
          "label": "Área",
          "kind": "choice",
          "options": [
            "energia",
            "apetite",
            "pelagem",
            "mobilidade",
            "digestão",
            "sono",
            "humor"
          ]
        },
        {
          "key": "score",
          "label": "Nota (0–5)",
          "kind": "scale",
          "min": 0,
          "max": 5
        },
        {
          "key": "at",
          "label": "Quando",
          "kind": "when",
          "isTime": true
        }
      ],
      "summary": "Bem-estar · {{area}} {{score}}/5"
    }
  },
  "intents": [
    {
      "id": "comida",
      "mode": "log",
      "event": "meal",
      "any": [
        "comeu",
        "comer",
        "jantou",
        "almocou",
        "dei",
        "gramas",
        "g"
      ],
      "strong": [
        "racao",
        "petisco",
        "biscoito",
        "bifinho",
        "sache",
        "ossinho"
      ],
      "none": [
        "eu comi",
        "comi",
        "ela comeu",
        "papinha",
        "leite",
        "mamou",
        "pode comer",
        "pode dar",
        "posso dar",
        "faz mal"
      ],
      "needsSubject": true,
      "slots": {
        "g": "qty:g",
        "food": "choice"
      }
    },
    {
      "id": "agua",
      "mode": "log",
      "event": "water",
      "any": [
        "agua",
        "bebeu",
        "pote de agua",
        "ml"
      ],
      "none": [
        "bebi",
        "eu bebi",
        "ela bebeu",
        "mamadeira",
        "leite"
      ],
      "needsSubject": true,
